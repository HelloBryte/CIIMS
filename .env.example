# Database Configuration
# =====================
# MySQL server host address
DB_HOST=localhost

# MySQL username
DB_USER=root

# MySQL password (change this to your actual password)
DB_PASSWORD=your_password

# Database name (will be created automatically if it doesn't exist)
DB_DATABASE=campus_system

# Database character set
DB_CHARSET=utf8mb4

# Connection pool size
DB_POOL_SIZE=5

# Logging Configuration
# =====================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Application Configuration
# ========================
APP_NAME=Campus Intelligent Inventory Management System
APP_VERSION=1.0.0

# Security Configuration
# =====================
PASSWORD_HASH_ROUNDS=12
